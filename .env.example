# ==============================================================================
# Environment Configuration Template: docker-rom-stack
# Copy this file to .env and configure local values during development.
# In production, this file is rendered from Ansible Vault by homelab-ops.
# ==============================================================================

# Application Environment (prod, stage, dev)
APP_ENV=dev
TZ=America/Detroit

# User and Group Mapping (Must match host UID/GID for NFS storage: seedbox-sys:media)
PUID=999
PGID=110

# Storage Mount Points
# Local Development: points to relative paths
# Production: Injected by Ansible as /opt/homelab/prod/data/docker-rom-stack and /mnt/nas/media
DATA_DIR=./data
MEDIA_DIR=/mnt/nas/media

# Service Port Bindings
ROMM_PORT=8082
GAMARR_PORT=8790

# Database Configuration (MariaDB)
DB_NAME=romm
DB_USER=romm-user
DB_PASSWD=romm_secret_change_me
DB_ROOT_PASSWD=romm_root_secret_change_me

# RomM Security & API Secrets
# Generate with: openssl rand -hex 32
ROMM_AUTH_SECRET_KEY=generate_random_secret_key_minimum_32_characters
ROMM_BASE_PATH=

# IGDB Scraper API Configuration (Twitch Developer Portal)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
STEAMGRIDDB_API_KEY=
MOBYGAMES_API_KEY=
HASHLIB_API_KEY=

# External Service Coordinates (Inter-Stack Integration on prd-seed-01.lan)
PROWLARR_URL=http://192.168.1.52:9696
PROWLARR_API_KEY=
TRANSMISSION_URL=http://192.168.1.52:9091
TRANSMISSION_USER=gemini
TRANSMISSION_PASS=
GLUETUN_HTTP_PROXY=http://192.168.1.52:8888
